# db
upstream dbadmin {
    server host.docker.internal:8084;
}

upstream dbweb {
    server host.docker.internal:3013;
}

# smartdata-mcp sidecar (TS, Streamable HTTP transport)
# 本地 dev 用 MCP_PORT=3010，避免与 dbgate-api 的 :3000 冲突
upstream mcp_smartdata {
    server host.docker.internal:3010;
}

# leap-aide chat-shell (branded chat UI) + per-user OpenClaw gateway (host services)
upstream aide_chat_shell {
    server host.docker.internal:3180;
}
upstream openclaw_admin {
    server host.docker.internal:18789;
}
# leap-aide admin console (L1 operator SPA, built+native; mock data in dev)
upstream aide_admin {
    server host.docker.internal:3280;
}
# leap-aide worktree dev frontend (Vite, parallel to the built /aide/ above)
upstream aide_wt {
    server host.docker.internal:5181;
}
# second worktree dev frontend slot (Vite :5182, base=/aide-wt2/) so two
# worktrees can be verified in parallel without evicting each other.
upstream aide_wt2 {
    server host.docker.internal:5182;
}

