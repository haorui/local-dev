server {
    listen      443 ssl;
    # http2;
    server_name dev.smartdata.local;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;

    ssl_certificate /etc/nginx/ssl/selfsigned.crt;
    ssl_certificate_key /etc/nginx/ssl/selfsigned.key;
    
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubdomains; preload";

    client_max_body_size 100M;

    # location /mqtt {
	   #  proxy_pass http://host.docker.internal:8083/mqtt;
    #     proxy_redirect off;
	   #  proxy_set_header Host $host;
    #     proxy_set_header X-Real-IP $remote_addr;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	   #  proxy_http_version 1.1;
    #     proxy_set_header Upgrade $http_upgrade;
    #     proxy_set_header Connection "Upgrade";
    # }

    # ai
    # location /chat {
    #     proxy_pass http://host.docker.internal:3008;
    #     proxy_set_header Host $host;
    #     proxy_set_header X-Real-IP $remote_addr;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    # }
    # location /agentic/ {
    #
    #   proxy_pass http://host.docker.internal:8000/;
    #
    #   proxy_http_version 1.1;
    #   proxy_set_header Upgrade $http_upgrade;
    #   proxy_set_header Connection "upgrade";
    #   proxy_set_header Host $host;
    #   proxy_set_header X-Real-IP $remote_addr;
    #   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #   proxy_set_header X-Forwarded-Proto $scheme;
    #
    #   proxy_buffering off;
    #   proxy_cache off;
    #
    #   proxy_read_timeout 86400s;
    #   proxy_send_timeout 86400s;
    #   proxy_connect_timeout 10s;
    #
    #   # proxy_set_header Connection "";
    #
    #   gzip off;
    #
    #   proxy_set_header Accept-Encoding "";
    # }

    # smartdata-mcp (Streamable HTTP / SSE) → sidecar 上的 /mcp
    # 客户端访问: https://dev.smartdata.local/mcp-smartdata/mcp
    # JWT 由 Authorization header 透传，sidecar 不解 token
    location /mcp-smartdata/ {
        proxy_pass http://mcp_smartdata/;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;

        # SSE: 关闭缓冲、关闭压缩、保留长连接
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header Accept-Encoding "";
        gzip off;

        # MCP 长流：避免中途被 nginx 截断（与注释里 /agentic/ 一致）
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
        proxy_connect_timeout 10s;
    }

    # db — in-app notification SSE (must precede generic /dbapi/ prefix match)
    # Client: https://dev.smartdata.local/dbapi/system/notifications/stream
    location /dbapi/system/notifications/stream {
        proxy_pass http://dbadmin/system/notifications/stream;

        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization $http_authorization;
        proxy_set_header X-Accel-Buffering no;

        proxy_buffering off;
        proxy_cache off;
        proxy_set_header Accept-Encoding "";
        gzip off;

        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_connect_timeout 10s;
    }
    # db
    location /dbapi/ {
        proxy_pass http://dbadmin/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
     #location /socket.io {
    location /dbgatex/api/terminal {

      proxy_pass http://host.docker.internal:3000/terminal;

      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection "upgrade";
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /dbgatex/api/ {
        proxy_pass http://host.docker.internal:3000/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location /dbgatex/ {
        proxy_pass http://host.docker.internal:5300/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    # swarm
    # location /dbgatex/ {
    #     proxy_pass http://traefik_service;
    #     proxy_set_header Host $host;
    #     proxy_set_header X-Real-IP $remote_addr;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    # }
    location /db/ {
        proxy_pass http://dbweb/db/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # sso
    # location /api/ {
    #     proxy_pass http://platformadmin/;
    #     proxy_set_header Host $host;
    #     proxy_set_header X-Real-IP $remote_addr;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    # }
    # location /console {
    #     proxy_pass http://platformweb;
    #     proxy_set_header Host $host;
    #     proxy_set_header X-Real-IP $remote_addr;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    # }
    # location /nodeapi/ {
    #     proxy_pass http://uccserver/;
    #     proxy_set_header Host $host;
    #     proxy_set_header X-Real-IP $remote_addr;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    # }
    # location /web/ {
    #     proxy_pass http://uccweb;
    #     proxy_set_header Host $host;
    #     proxy_set_header X-Real-IP $remote_addr;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    # }
    # location / {
    #     proxy_pass http://uccserver;
    #     proxy_set_header Host $host:$server_port;
    #     proxy_set_header X-Real-IP $remote_addr;
    #     proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #     proxy_set_header X-Forwarded-Host $host;
    #     proxy_set_header X-Forwarded-Proto $scheme;
    #     proxy_set_header X-Forwarded-Port $server_port;
    # }
    # ── leap-aide chat-shell (branded chat UI over OpenClaw) ─────────────
    # COOKIE CONTRACT: these routes depend on dbmanager's `authorized-token`
    # cookie (js-cookie default path=/, host dev.smartdata.local) being present
    # AND non-expired. The SPA gate reads it via document.cookie; the WS
    # auth_request forwards it ($http_cookie) to /api/auth/check, which writes
    # the broker session key `leapaide:user:<id>` with TTL = cookie.expires - now.
    # So a short/stale cookie `expires` cascades: browser deletes the cookie
    # (SPA → /db/login redirect) and/or the broker returns user-not-found even
    # with an otherwise-valid JWT. Path is NOT the issue (js-cookie default is /);
    # the load-bearing field is `expires`. (Observed in dev 2026-06-23.)
    #
    # Internal auth probe: chat-shell validates the SmartData cookie and echoes
    # X-Aide-User. `internal` keeps it off the public surface (auth_request only).
    location = /aide/api/auth/check {
        internal;
        proxy_pass http://aide_chat_shell/api/auth/check;
        proxy_set_header Cookie $http_cookie;
        proxy_set_header Host $host;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
    }
    # SPA + /api/* glue. Trailing slash on proxy_pass strips /aide/ so the Node
    # server (static at root) resolves /aide/assets/* correctly.
    location /aide/ {
        proxy_pass http://aide_chat_shell/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    # leap-aide admin console (L1 operator UI). Mirrors /aide/: trailing slash
    # strips /aide-admin/ so the Node server (static at root) resolves
    # /aide-admin/assets/* correctly. No auth_request — the admin console has no
    # gateway WS to gate; the client-side cookie probe handles the SSO redirect.
    # Data is mock in dev. Remove this block + reload to retire it.
    location /aide-admin/ {
        proxy_pass http://aide_admin/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    # leap-aide worktree dev frontend (Vite :5181, base=/aide-wt/). Parallel path
    # so a worktree UI can be verified in the browser without disturbing the main
    # checkout's /aide/. NO trailing slash on proxy_pass: keep the /aide-wt/ prefix
    # (matches Vite base). Upgrade headers carry Vite's HMR websocket. The SPA
    # reuses the SAME backend as /aide/: gateway WS via /leap-aide/u/admin/ below,
    # auth via /aide/api/auth/check. Remove this block + reload to retire it.
    location /aide-wt/ {
        proxy_pass http://aide_wt;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
    # Second worktree slot (Vite :5182, base=/aide-wt2/). Same contract as
    # /aide-wt/ above — reuses /aide/'s auth check + the shared gateway WS — but a
    # separate port so two worktrees verify in parallel. Remove + reload to retire.
    location /aide-wt2/ {
        proxy_pass http://aide_wt2;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
    # Per-user OpenClaw gateway (WebSocket). auth_request → X-Aide-User →
    # x-forwarded-user for OpenClaw trusted-proxy auth. Strip the user prefix.
    location /leap-aide/u/admin/ {
        auth_request /aide/api/auth/check;
        auth_request_set $aide_user $upstream_http_x_aide_user;
        proxy_set_header x-forwarded-user  $aide_user;
        proxy_set_header x-forwarded-proto $scheme;
        proxy_set_header x-forwarded-host  $host;
        proxy_set_header x-forwarded-for   $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
        rewrite ^/leap-aide/u/admin/(.*)$ /$1 break;
        proxy_pass http://openclaw_admin;
    }
    # The Control UI auto-detects its WebSocket URL WITHOUT a trailing slash
    # (wss://…/leap-aide/u/admin), which the prefix location above (…/admin/)
    # never matches. This exact-match block proxies that bare path to the gateway
    # root so the dashboard connects automatically — no manual slash fix-up.
    location = /leap-aide/u/admin {
        auth_request /aide/api/auth/check;
        auth_request_set $aide_user $upstream_http_x_aide_user;
        proxy_set_header x-forwarded-user  $aide_user;
        proxy_set_header x-forwarded-proto $scheme;
        proxy_set_header x-forwarded-host  $host;
        proxy_set_header x-forwarded-for   $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_pass http://openclaw_admin/;
    }

    error_page   500 502 503 504  /50x.html;
    location = /50x.html {
        root   /usr/share/nginx/html;
    }
}
server {
    listen 80;
    listen [::]:80;
    server_name  dev.smartdata.local;
    return 301 https://$host:$server_port$request_uri;
    # rewrite ^(.*)$ https://$host$1 permanent;
}

