HIVE_SITE_CONF_javax_jdo_option_ConnectionURL=jdbc:postgresql://postgres9/metastore
HIVE_SITE_CONF_javax_jdo_option_ConnectionDriverName=org.postgresql.Driver
HIVE_SITE_CONF_javax_jdo_option_ConnectionUserName=postgres
HIVE_SITE_CONF_javax_jdo_option_ConnectionPassword=123456
HIVE_SITE_CONF_datanucleus_autoCreateSchema=false
# 让 HiveServer2 使用内嵌 Metastore（直接连 PostgreSQL），避免通过 Thrift 远程调用 Metastore 触发 set_ugi/get_all_functions 相关的 TTransportException
#HIVE_SITE_CONF_hive_metastore_uris=thrift://metastore-hive2:9083

# Hive Metastore：保持为非 Kerberos（避免 Hive 2.3.2 在 root UGI 下触发 HadoopThriftAuthBridge bug）
HIVE_SITE_CONF_hive_metastore_sasl_enabled=false

# HiveServer2：启用 Kerberos 认证（只对外部客户端，Metastore 仍 simple）
HIVE_SITE_CONF_hive_server2_authentication=KERBEROS
HIVE_SITE_CONF_hive_server2_authentication_kerberos_principal=hive/hadoop@TEST.COM
HIVE_SITE_CONF_hive_server2_authentication_kerberos_keytab=/opt/hive/conf/hive.keytab
# HiveServer2：自定义 Thrift 端口为 10020（与宿主机映射端口一致，解决 ZK 动态发现端口问题）
HIVE_SITE_CONF_hive_server2_thrift_port=10020

# HiveServer2 + ZooKeeper：启用 ZK 动态发现（ACL 问题已通过源码修改修复）
# 修改后的代码会在 ZK Kerberos 启用时使用 sasl scheme ACL，修复了 InvalidACL 错误
HIVE_SITE_CONF_hive_zookeeper_quorum=zoo1
HIVE_SITE_CONF_hive_server2_support_dynamic_service_discovery=true
HIVE_SITE_CONF_hive_server2_zookeeper_namespace=hiveserver2
HIVE_SITE_CONF_hive_zookeeper_kerberos_enabled=true

# 为简化本地环境，关闭基于 SQL 标准的授权（避免 HS2 启动时调用 get_all_functions 失败）
HIVE_SITE_CONF_hive_security_authorization_enabled=false
HIVE_SITE_CONF_hive_security_authorization_manager=org.apache.hadoop.hive.ql.security.authorization.DefaultHiveAuthorizationProvider

# 禁用 Metastore 的 set_ugi 调用，避免 Hive 2.3.2 在简单模式下通过 Thrift set_ugi 触发 TTransportException
HIVE_SITE_CONF_hive_metastore_execute_setugi=false

# 本地文件系统模式：让 Metastore/HS2 把 warehouse 与 scratchdir 落到 file://，避免依赖 HDFS
HIVE_SITE_CONF_hive_metastore_warehouse_dir=file:/user/hive/warehouse
HIVE_SITE_CONF_hive_exec_scratchdir=file:/tmp/hive
HIVE_SITE_CONF_hive_exec_local_scratchdir=/tmp/hive/local
HDFS_CONF_dfs_namenode_datanode_registration_ip___hostname___check=false

# HDFS Kerberos：为 NameNode / DataNode 配置 principal 和 keytab
CORE_CONF_hadoop_security_authentication=kerberos
CORE_CONF_hadoop_security_authorization=true
HDFS_CONF_dfs_namenode_kerberos_principal=nn/namenode-hive2@TEST.COM
HDFS_CONF_dfs_namenode_keytab_file=/etc/security/keytabs/nn.keytab
HDFS_CONF_dfs_datanode_kerberos_principal=dn/datanode-hive2@TEST.COM
HDFS_CONF_dfs_datanode_keytab_file=/etc/security/keytabs/dn.keytab

# NameNode Web UI 的 SPNEGO/HTTP Kerberos 配置
HDFS_CONF_dfs_web_authentication_kerberos_principal=HTTP/namenode-hive2@TEST.COM
HDFS_CONF_dfs_web_authentication_kerberos_keytab=/etc/security/keytabs/http.keytab

# DataNode 数据传输：启用基于 SASL 的 data transfer 保护，避免必须使用特权端口
HDFS_CONF_dfs_data_transfer_protection=authentication
# 保持 HTTP UI 为非 HTTPS，后续如需可再引入 SSL 配置
HDFS_CONF_dfs_http_policy=HTTP_ONLY

# 为 MapReduce/YARN 提供一个“Master Kerberos principal”，避免 TokenCache 在提交 MR 任务时因为 renewer 为空而失败
# 这里复用 hive 服务主体即可；本地没有真正的 YARN/ResourceManager 进程，只是为了让 getMasterPrincipal() 不再抛错
MAPRED_CONF_mapreduce_jobtracker_kerberos_principal=hive/hadoop.test.com@TEST.COM
YARN_CONF_yarn_resourcemanager_principal=hive/hadoop.test.com@TEST.COM

CORE_CONF_fs_defaultFS=hdfs://namenode-hive2:8020
CORE_CONF_hadoop_http_staticuser_user=root
CORE_CONF_hadoop_proxyuser_hue_hosts=*
CORE_CONF_hadoop_proxyuser_hue_groups=*

HDFS_CONF_dfs_webhdfs_enabled=true
HDFS_CONF_dfs_permissions_enabled=false

YARN_CONF_yarn_log___aggregation___enable=true
YARN_CONF_yarn_resourcemanager_recovery_enabled=true
YARN_CONF_yarn_resourcemanager_store_class=org.apache.hadoop.yarn.server.resourcemanager.recovery.FileSystemRMStateStore
YARN_CONF_yarn_resourcemanager_fs_state___store_uri=/rmstate
YARN_CONF_yarn_nodemanager_remote___app___log___dir=/app-logs
YARN_CONF_yarn_log_server_url=http://historyserver:8188/applicationhistory/logs/
YARN_CONF_yarn_timeline___service_enabled=true
YARN_CONF_yarn_timeline___service_generic___application___history_enabled=true
YARN_CONF_yarn_resourcemanager_system___metrics___publisher_enabled=true
YARN_CONF_yarn_resourcemanager_hostname=resourcemanager
YARN_CONF_yarn_timeline___service_hostname=historyserver
YARN_CONF_yarn_resourcemanager_address=resourcemanager:8032
YARN_CONF_yarn_resourcemanager_scheduler_address=resourcemanager:8030
YARN_CONF_yarn_resourcemanager_resource__tracker_address=resourcemanager:8031
