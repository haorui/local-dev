# -------- VLLM  --------
# 是否使用 ModelScope
VLLM_USE_MODELSCOPE=true

# 模型名称（外对提供的名称）
VLLM_SERVED_MODEL_NAME=gpt-oss-20b

# 模型路径 (如果是本地 /root/models/xxx，如果是 HuggingFace/ModelScope 就直接填路径)
VLLM_MODEL=openai-mirror/gpt-oss-20b

# Tensor 並行数，根据实际GPU调整
VLLM_TENSOR_PARALLEL_SIZE=2

# 最大上下文长度
VLLM_MAX_MODEL_LEN=32768
# GPU 内存使用率
VLLM_GPU_MEMORY_UTILIZATION=0.9
# 单批次最大 token 数
VLLM_MAX_NUM_BATCHED_TOKENS=8192
# 单批次最大请求数
VLLM_MAX_NUM_SEQS=512
# 启动cpu ram当前显存溢出缓冲区 避免OOM 但会变慢
VLLM_SWAP_SPACE=16

# -------- Docker 资源限制 --------
# CPU 限制 (核)
VLLM_CPUS=16.0
# memory 限制 (GB)
VLLM_MEMORY=96g

# -------- 端口 --------
VLLM_PORT=8000

