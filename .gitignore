# Nuxt dev/build outputs
.output
.data
.nuxt
.nitro
.cache
dist
.data/**

# Node dependencies
node_modules

# Logs
logs
*.log

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example

# Runtime sockets / pids
*.sock
*.pid

# Container runtime state (per-service data dirs, never commit)
db/**/data/
db/**/hive_data/
dns/**/data/
kerberos/data/

# Local SSL — regenerate with mkcert per developer
**/selfsigned.key
**/selfsigned.crt
**/selfsigned.*.bak-*

# License test artifacts
dbmanager/license/tar*/
dbmanager/license/encrypted.*

# Compiled JARs (driver / plugin binaries — fetched/built, not source)
*.jar

# Vault local config (may contain tokens)
vault/vault/config/local.json
vault/vault/config/vault.hcl
vault/vault/config/vault.mysql.hcl
