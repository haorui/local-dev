# SmartData source checkout. Override this for a specific worktree.
SMARTDATA_SOURCE_DIR=../../smartdata

# Sibling source checkouts used by the containerized admin, API, and manager.
# dbgate-web mounts the generated packages/web/public artifact from DBGATE_SOURCE_DIR.
DBMANAGER_SOURCE_DIR=../../dbmanager
DBGATE_SOURCE_DIR=../../dbgate
SMARTDATA_MCP_SOURCE_DIR=../../smartdata-mcp

# Existing dependency network and local secret files. These files stay outside
# local-dev; do not copy their values into this example file.
DEV_DB_NETWORK=dev_db_network
SMARTDATA_ENV_FILE=../../smartdata/.env.dev
DBGATE_API_ENV_FILE=../../dbgate/packages/api/.env.local

# All four services run in Compose by default. For hybrid migration testing,
# override both admin URLs to http://host.docker.internal:8084.
DBGATE_API_ADMIN_URL=http://smartdata-admin:8084
# Java Gateway is the SQL/editor upstream. In container mode it uses the
# Compose service name; set the host to host.docker.internal for hybrid mode.
DBGATE_JAVA_GATEWAY_ENABLED=true
DBGATE_JAVA_GATEWAY_HOST=smartdata-admin
DBGATE_JAVA_GATEWAY_PORT=8084
DBGATE_JAVA_GATEWAY_PROTOCOL=http
DBMANAGER_DEV_API_URL=http://smartdata-admin:8084
DBMANAGER_API_URL_PREFIX=/dbapi
DBMANAGER_USE_POLLING=false
DBGATE_DB_DATABASE=smartdata_dev
SMARTDATA_DB_NAME=smartdata_dev

# smartdata-mcp container mode. The service uses Compose DNS for SmartData;
# host mode remains available through ../smartdata/make dev-smartdata-mcp.
SMARTDATA_MCP_ADMIN_URL=http://smartdata-admin:8084
SMARTDATA_MCP_UPSTREAM_BASE_PATH=/agent-api/v1
SMARTDATA_MCP_UPSTREAM_TIMEOUT_MS=30000
# Include the Compose DNS name so sibling containerized clients can call MCP.
SMARTDATA_MCP_ALLOWED_HOSTS=localhost:3010,127.0.0.1:3010,dev.smartdata.local,smartdata-mcp:3010

# Host-side development TLS directory. The compose file mounts selected files only.
TRUSTED_PROXY_DEV_TLS_DIR=${HOME}/.smartdata/dev/trusted-proxy

# Local-dev inputs consumed by the optional Trusted Proxy service. Compose maps
# these to the container's REDIS_* / TRUSTED_PROXY_* variables.
# The password must match redis/single/redis.conf and smartdata/.env.dev.
LOCAL_DEV_REDIS_HOST=host.docker.internal
LOCAL_DEV_REDIS_PORT=6379
LOCAL_DEV_REDIS_PASSWORD=replace-with-local-redis-password
LOCAL_DEV_TRUSTED_PROXY_RELEASE_ENDPOINT=https://host.docker.internal:8444/trusted-proxy/credential/release

# Published host ports. Internal application ports stay at 8443 / 8087 / 3128.
TP_HOST_LISTEN_PORT=8443
TP_HOST_MGMT_PORT=8087
TP_HOST_FORWARD_PROXY_PORT=3128
TRUSTED_PROXY_FORWARD_PROXY_ENABLED=true

# Four-service container-mode host ports. They intentionally match the nginx
# host-gateway upstreams and the existing SmartData make dev ports.
SMARTDATA_BIND_ADDRESS=0.0.0.0
SMARTDATA_ADMIN_HOST_PORT=8084
SMARTDATA_RELEASE_HOST_PORT=8444
DBMANAGER_HOST_PORT=3013
DBGATE_API_HOST_PORT=3000
DBGATE_WEB_HOST_PORT=5300
SMARTDATA_MCP_HOST_PORT=3010

# SmartData admin state and release TLS mounts.
SMARTDATA_AUTH_RSA_DIR=${HOME}/.smartdata/dev/auth-rsa
SMARTDATA_ONTOLOGY_DIR=${HOME}/.smartdata/ontology
# Keeps the downloaded JDBC driver cache across container recreation.
SMARTDATA_DRIVERS_DIR=${HOME}/.smartdata/drivers
SMARTDATA_ADMIN_TLS_DIR=${HOME}/.smartdata/dev/trusted-proxy
SMARTDATA_LOG_DIR=./.data/admin-logs

# Maven/Java memory guard for the admin container (only used when it falls back
# to an in-container build). SMARTDATA_SKIP_BUILD=true starts the host-built
# target/smartdata-admin.jar directly; rebuild it with `make smartdata-admin-rebuild`.
SMARTDATA_MAVEN_OPTS=-Xmx768m -XX:MaxMetaspaceSize=384m
SMARTDATA_JAVA_TOOL_OPTIONS=-Xms256m -Xmx1024m
SMARTDATA_SKIP_BUILD=true
